#undef ZMK_BEHAVIORS_KEEP_ALL

#define ZMK_BEHAVIORS_KEEP_IND
#define ZMK_BEHAVIORS_KEEP_BT
#define ZMK_BEHAVIORS_KEEP_GRESC
#define ZMK_BEHAVIORS_KEEP_SYS_RESET
#define ZMK_BEHAVIORS_KEEP_BOOTLOADER
#define ZMK_BEHAVIORS_KEEP_CAPS_WORD
#define ZMK_BEHAVIORS_KEEP_KEY_REPEAT
#define ZMK_BEHAVIORS_KEEP_KT
#define ZMK_BEHAVIORS_KEEP_LT
#define ZMK_BEHAVIORS_KEEP_MT
#define ZMK_BEHAVIORS_KEEP_SK
#define ZMK_BEHAVIORS_KEEP_STICKY_LAYER
#define ZMK_BEHAVIORS_KEEP_TO
#define ZMK_BEHAVIORS_KEEP_TOG
#define ZMK_BEHAVIORS_KEEP_TRANS

#include <behaviors/indicators.dtsi>
#include <dt-bindings/zmk/indicators.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    behaviours {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-terms-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 37 36>;
            require-prior-idle-ms = <125>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE  &kp Q               &kp W           &kp E               &kp R             &kp T           &kp Y      &kp U             &kp I           &kp O            &kp P                  &kp LEFT_BRACKET
&kp MINUS  &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_COMMAND D  &hml LEFT_SHIFT F  &kp G           &kp H      &hmr LEFT_SHIFT J  &hmr LEFT_GUI K  &hmr RIGHT_ALT L  &hmr LEFT_CONTROL SEMI  &kp SQT
&kp EQUAL  &kp Z               &kp X           &kp C               &kp V             &kp B           &kp N      &kp M             &kp COMMA       &kp DOT          &kp SLASH              &kp RIGHT_BRACKET
                                               &lt 3 TAB           &lt 1 SPACE       &lt 2 ESCAPE    &kp ENTER  &lt 4 BACKSPACE   &lt 5 DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_u_d>;
        };

        Numbers {
            bindings = <
&none  &none             &none         &none         &none           &none    &none          &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY  &kp KP_DIVIDE
&none  &kt LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &none    &none          &kp N4  &kp N5  &kp N6  &kp KP_PLUS      &kp KP_MINUS
&none  &none             &none         &none         &none           &none    &kp BACKSLASH  &kp N1  &kp N2  &kp N3  &kp KP_DOT       &kp KP_EQUAL
                                       &none         &none           &none    &none          &kp N0  &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>,
                <&scroll_l_r>;
        };

        Functions {
            bindings = <
&none  &none             &none         &none         &none           &none    &caps_word  &kp F7  &kp F8  &kp F9  &kp F12  &kp PRINTSCREEN
&none  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &none    &none       &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &none             &none         &none         &none           &none    &none       &kp F1  &kp F2  &kp F3  &kp F10  &none
                                       &none         &none           &none    &none       &none   &none
            >;
        };

        Bluetooth {
            bindings = <
&out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_CLR   &out OUT_USB    &none        &none        &none  &none  &none  &none
&none         &none         &none         &none           &none        &none           &none        &none        &none  &none  &none  &none
&sys_reset    &bootloader   &none         &studio_unlock  &ind IND_ON  &ind BAT_ST     &ind IND_ON  &ind BAT_ST  &none  &none  &none  &none
                                          &mo 3           &mo 1        &kp SPACE       &kp ENTER    &mo 1        &mo 2
            >;
        };

        Navigation {
            bindings = <
&none          &none  &none     &kp UP_ARROW  &none      &none       &none  &none           &none         &none         &none             &none
&kp PAGE_UP    &none  &kp LEFT  &kp DOWN      &kp RIGHT  &kp HOME    &none  &kp LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &none
&kp PAGE_DOWN  &none  &none     &none         &none      &kp END     &none  &none           &none         &none         &none             &none
                                &none         &none      &none       &none  &none           &none
            >;
        };

        MouseNavigation {
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &none            &none        &none  &none           &none         &none         &none             &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none        &none  &kp LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &none
&none  &none  &none           &none           &none            &none        &none  &none           &none         &none         &none             &none
                              &mkp RCLK       &mkp LCLK        &mkp MCLK    &none  &none           &none
            >;
        };
    };
};
